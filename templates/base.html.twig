<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>

    {{ include('_head_assets.html.twig') }}
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar has-background-info-light" role="navigation" aria-label="main navigation" data-controller="navbar">
    <div class="navbar-brand">
        <a class="navbar-item" href="https://www.kyudo.fr/">
            <img src="{{ asset('logo_fr.jpg') }}" alt="Comité National De Kyudo">
        </a>
        <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false"
           data-navbar-target="burger" data-action="click->navbar#toggle">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </a>
    </div>
    <div class="navbar-menu" data-navbar-target="menu">
        <div class="navbar-start">
            <a class="navbar-item" href="{{ path('app_taikai_index') }}">
                <span class="icon is-medium mr-2" style="white-space:nowrap">大会</span>
                <span>{{ 'nav.taikais'|trans }}</span>
            </a>
            <a class="navbar-item" href="{{ path('app_dojo_index') }}">
                <span class="icon is-medium mr-2" style="white-space:nowrap">道場</span>
                <span>{{ 'nav.dojos'|trans }}</span>
            </a>
        </div>
        <div class="navbar-end">
            {% if app.user %}
                <a class="navbar-item" href="{{ asset('docs/guide.pdf') }}" target="_blank">
                    <span class="icon is-medium"><i class="fas fa-compass"></i></span>
                    <span>{{ 'nav.guide'|trans }}</span>
                </a>
                <a class="navbar-item" href="{{ asset('docs/tutorial.pdf') }}" target="_blank">
                    <span class="icon is-medium"><i class="fas fa-circle-question"></i></span>
                    <span>{{ 'nav.tutorial'|trans }}</span>
                </a>
                <a class="navbar-item" href="{{ path('app_account_edit') }}">{{ 'nav.account'|trans }}</a>
            {% endif %}
            <div class="navbar-item">
                <div class="buttons">
                    {% if app.user %}
                        <form method="post" action="{{ path('app_logout') }}">
                            <button class="button" type="submit">
                                <span class="icon is-medium"><i class="fas fa-power-off"></i></span>
                                <span>{{ 'nav.logout'|trans }}</span>
                            </button>
                        </form>
                    {% else %}
                        <a class="button" href="{{ path('app_login') }}">
                            <span class="icon is-medium"><i class="fas fa-sign-in-alt"></i></span>
                            <span>{{ 'nav.login'|trans }}</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</nav>

<section class="section">
    <div class="container">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                {# Un message peut être une simple clé, ou une paire clé/paramètres. #}
                <div class="notification is-{{ type == 'error' ? 'danger' : type }}">
                    {{ message is iterable ? message.key|trans(message.parameters|default({})) : message|trans }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </div>
</section>

{% block javascripts %}{% endblock %}
{% block importmap %}{{ importmap('app') }}{% endblock %}
</body>
</html>
