{# Clubs hôtes du taikai, reprise de `participating_dojos/_list.html.erb`.
   Partagée entre `taikai/show.html.twig` et `taikai/edit.html.twig`. #}
{% set canAddHost = taikai.distributed or taikai.participatingDojos|length == 0 %}
<table class="table is-narrow is-hoverable is-fullwidth">
    <thead>
    <tr class="has-text-centered">
        <th>{{ 'participating_dojo.display_name'|trans }}</th>
        <th>{{ 'dojo.city'|trans }}</th>
        <th>{{ 'dojo.country_code'|trans }}</th>
        <th>{{ 'participating_dojo.num_participants'|trans }}</th>
        <th class="has-text-right">
            {% if is_granted('TAIKAI_EDIT', taikai) and canAddHost %}
                <a class="button is-small has-background-light"
                   href="{{ path('app_participating_dojo_new', {taikaiId: taikai.id}) }}"
                   title="{{ 'participating_dojo.new'|trans }}">
                    <span class="icon is-small"><i class="fas fa-plus"></i></span>
                    <span>{{ 'action.add'|trans }}</span>
                </a>
            {% endif %}
        </th>
    </tr>
    </thead>
    <tbody>
    {% for participatingDojo in taikai.participatingDojos %}
        <tr>
            <td>{{ participatingDojo.displayName }}</td>
            <td>{{ participatingDojo.dojo ? participatingDojo.dojo.city : '' }}</td>
            <td>{{ participatingDojo.dojo and participatingDojo.dojo.countryCode ? participatingDojo.dojo.countryCode|country_name : '' }}</td>
            <td>{{ participatingDojo.participants|length }}</td>
            <td class="has-text-right">
                {% if is_granted('PARTICIPATING_DOJO_EDIT', participatingDojo) %}
                    <form method="post" style="display:inline"
                          action="{{ path('app_participating_dojo_draw', {taikaiId: taikai.id, id: participatingDojo.id}) }}"
                          onsubmit="return confirm('{{ 'draw.confirm'|trans|e('js') }}')">
                        <input type="hidden" name="_token" value="{{ csrf_token('draw' ~ participatingDojo.id) }}">
                        <button class="button is-small has-background-light" type="submit" title="{{ 'draw.label'|trans }}">
                            <span class="icon is-small"><i class="fas fa-dice"></i></span>
                        </button>
                    </form>
                    <a class="button is-small has-background-light"
                       href="{{ path('app_participating_dojo_edit', {taikaiId: taikai.id, id: participatingDojo.id}) }}"
                       title="{{ 'participating_dojo.edit'|trans }}">
                        <span class="icon is-small"><i class="fas fa-pen"></i></span>
                    </a>
                {% endif %}
                {% if is_granted('PARTICIPATING_DOJO_DELETE', participatingDojo) %}
                    <form method="post" style="display:inline"
                          action="{{ path('app_participating_dojo_delete', {taikaiId: taikai.id, id: participatingDojo.id}) }}"
                          onsubmit="return confirm('{{ 'participating_dojo.delete.confirm'|trans|e('js') }}')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ participatingDojo.id) }}">
                        <button class="button is-small has-background-light" type="submit" title="{{ 'participating_dojo.destroy'|trans }}">
                            <span class="icon is-small"><i class="fas fa-trash"></i></span>
                        </button>
                    </form>
                {% endif %}
            </td>
        </tr>
    {% else %}
        <tr><td colspan="5" class="has-text-centered has-text-grey">{{ 'taikai.no_host_club'|trans }}</td></tr>
    {% endfor %}
    </tbody>
</table>
