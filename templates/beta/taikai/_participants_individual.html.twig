
{% set isRegistration = taikai.isState(
    constant('App\\Enum\\TaikaiState::Registration')
) %}

<table class="table is-narrow is-hoverable is-fullwidth is-size-6">
    <thead>
    <tr class="has-text-centered">
        <th>{{ 'participant.index'|trans }}</th>
        <th>{{ 'participant.firstname'|trans }}</th>
        <th>{{ 'participant.lastname'|trans }}</th>
        <th></th> <!--- if participant.kyudojin --->
        <th>{{ 'participant.club'|trans }}</th>
        <th>{{ 'action.actions'|trans }}</th>
        <th>{{ 'taikai.participants_overview.dojo'|trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% for participatingDojo in taikai.participatingDojos %}
        {% if participatingDojo.participants|length == 0 %}
            <tr>
                <td colspan="6" class="has-text-centered has-text-grey">{{ 'participant.empty'|trans }}</td>
                <td rowspan="{{ participatingDojo.participants|length }}">
                    <ul>
                        <li>
                            {{ participatingDojo.displayName }}
                            {% if is_granted('PARTICIPATING_DOJO_EDIT', participatingDojo) and isRegistration %}
                                <a class="button is-small has-background-light"
                                href="{{ path('app_participant_new', {taikaiId: taikai.id, participatingDojoId: participatingDojo.id}) }}"
                                title="{{ 'participant.new'|trans }} ({{ participatingDojo.displayName }})">
                                    <span class="icon is-small"><i class="fas fa-plus"></i></span>
                                    <span>{{ 'action.add'|trans }}</span>
                                </a>
                            {% endif %}
                        </li>
                        <li>
                            {% if is_granted('PARTICIPATING_DOJO_EDIT', participatingDojo) and isRegistration %}
                            {{ include('participant/_import_excel.html.twig', {taikai: taikai, participatingDojo: participatingDojo, size: 'is-small'}) }}
                            {% endif %}
                        </li>
                    </ul>
                </td>
            </tr>

        {% else %}

            {% for participant in participatingDojo.participants %}
                <tr>
                    <td>{{ participant.index }}</td>
                    <td>{{ participant.firstname }}</td>
                    <td>{{ participant.lastname }}</td>
                    <td>{% if participant.kyudojin %}<i class="far fa-id-badge"></i>{% endif %}</td>
                    <td>{{ participant.club }}</td>
                    <td>
                        <!-- Edit participant -->
                        <a class="button is-small has-background-light"
                        href="{{ path('app_participant_edit', {taikaiId: taikai.id, participatingDojoId: participatingDojo.id, id: participant.id}) }}"
                        title="{{ 'participant.edit'|trans }}">
                            <span class="icon is-small"><i class="fas fa-pen"></i></span>
                        </a>
                        <!-- Delete participant -->
                        {% if is_granted('TAIKAI_EDIT', taikai) and isRegistration %}
                        <form method="post" style="display:inline"
                            action="{{ path('app_participant_delete', {taikaiId: taikai.id, participatingDojoId: participatingDojo.id, id: participant.id}) }}"
                            onsubmit="return confirm('{{ 'participant.delete.confirm'|trans|e('js') }}')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ participant.id) }}">
                            <button class="button is-small has-background-light" type="submit" title="{{ 'participant.destroy'|trans }}">
                                <span class="icon is-small"><i class="fas fa-trash"></i></span>
                            </button>
                        </form>
                        {% endif %}
                    </td>
                    {% if loop.first %}
                        <td rowspan="{{ participatingDojo.participants|length }}">
                            <ul>
                                <li>
                                    {{ participatingDojo.displayName }}
                                    {% if is_granted('TAIKAI_EDIT', taikai) and isRegistration %}
                                    <!-- Draw participants -->
                                    <form method="post" style="display:inline"
                                        action="{{ path('app_participating_dojo_draw', {taikaiId: taikai.id, id: participatingDojo.id}) }}"
                                        onsubmit="return confirm('{{ 'draw.confirm'|trans|e('js') }}')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('draw' ~ participatingDojo.id) }}">
                                        <button class="button is-small has-background-light" type="submit" title="{{ 'draw.label'|trans }}">
                                            <span class="icon is-small"><i class="fas fa-dice"></i></span>
                                        </button>
                                    </form>
                                    <!-- Add participant -->
                                    <a class="button is-small has-background-light"
                                    href="{{ path('app_participant_new', {taikaiId: taikai.id, participatingDojoId: participatingDojo.id}) }}"
                                    title="{{ 'participant.new'|trans }} ({{ participatingDojo.displayName }})">
                                        <span class="icon is-small"><i class="fas fa-plus"></i></span>
                                        <span>{{ 'action.add'|trans }}</span>
                                    </a>
                                    {% endif %}
                                </li>
                                <li>
                                    <!-- Import Excel -->
                                    {% if is_granted('TAIKAI_EDIT', taikai) and isRegistration %}
                                    {{ include('participant/_import_excel.html.twig', {taikai: taikai, participatingDojo: participatingDojo, size: 'is-small'}) }}
                                    {% endif %}
                                </li>

                            </ul>
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
        {% endif %}

    {% endfor %}
    </tbody>
</table>

