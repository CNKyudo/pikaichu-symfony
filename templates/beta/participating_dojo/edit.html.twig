{% extends 'taikai/_layout.html.twig' %}

{% 
    set beforeRegistration = taikai.isState(constant('App\\Enum\\TaikaiState::New'))
    or taikai.isState(constant('App\\Enum\\TaikaiState::Registration'))
%}

{% block title %}{{ 'participating_dojo.edit'|trans }} · {{ app_name }}{% endblock %}
{% block taikai_content %}
<div class="card">
    <header class="card-header"><p class="card-header-title">{{ 'participating_dojo.edit'|trans }}</p></header>
    <div class="card-content">
        <nav class="breadcrumb has-succeeds-separator" aria-label="breadcrumbs">
            <ul>
                <li><a href="{{ path('app_taikai_edit', {id: taikai.id}) }}">{{ taikai.shortname }}</a></li>
                <li class="is-active"><a aria-current="page">{{ participatingDojo.displayName }}</a></li>
            </ul>
        </nav>
        <p><b>{{ 'dojo.name'|trans }}</b>: {{ participatingDojo.dojo.name }}</p>
        {% if participatingDojo.dojo.city %}
            <b>{{ 'dojo.city'|trans }}</b>: {{ participatingDojo.dojo.city }}
        {% endif %}
        <p><b>{{ 'dojo.country_code'|trans }}</b>: {{ participatingDojo.dojo.countryCode ? participatingDojo.dojo.countryCode|country_name : '' }}</p>
        
        {{ include('participating_dojo/_form.html.twig', {size: 'is-small'}) }}
    </div>
</div>

{% if is_granted('PARTICIPATING_DOJO_EDIT', participatingDojo) and beforeRegistration %}
<div class="card">
    <header class="card-header"><p class="card-header-title">{{ 'participant.import.title'|trans }}</p></header>
    <div class="card-content">
        {{ include('participant/_import_excel.html.twig', {taikai: taikai, participatingDojo: participatingDojo, size: 'is-small'}) }}
    </div>
</div>
{% endif %}

{# Hors tournoi individuel, les participants se saisissent par équipe. #}
{% if taikai.form and taikai.form.value == 'individual' %}
    <div class="card mt-5">
        <header class="card-header"><p class="card-header-title">{{ 'taikai.participants'|trans }}</p></header>
        <div class="card-content">
            {{ include('participant/_list.html.twig') }}
        </div>
    </div>
{% else %}
    <div class="card mt-5">
        <header class="card-header"><p class="card-header-title">{{ 'team.title'|trans }}</p></header>
        <div class="card-content">
            {{ include('team/_list.html.twig') }}
        </div>
    </div>
{% endif %}

{% endblock %}
