{# Thème de formulaire minimal aux classes Bulma. #}
{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="field">
        {{ form_label(form) }}
        <div class="control">{{ form_widget(form) }}</div>
        {% if help is defined and help %}
            <p class="help">{{ help|trans }}</p>
        {% endif %}
        {{ form_errors(form) }}
    </div>
{% endblock %}

{% block form_label %}
    {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' label')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        {% for error in errors %}
            <p class="help is-danger">{{ error.message }}</p>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set type = type|default('text') %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' textarea')|trim}) %}
    {{ parent() }}
{% endblock %}

{# Un champ en autocomplétion (ux-autocomplete/TomSelect) a déjà sa propre
   flèche et son propre habillage : le wrapper `.select` de Bulma ajouterait
   une seconde flèche superposée à la sienne. #}
{% block choice_widget_collapsed %}
    {% if uses_autocomplete|default(false) %}
        {{ parent() }}
    {% else %}
        <div class="select is-fullwidth">{{ parent() }}</div>
    {% endif %}
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' checkbox')|trim}) %}
    {{ parent() }}
{% endblock %}

{# Bulma attend la case et son libellé dans le même <label>, pas l'un au-dessus
   de l'autre comme le fait form_row par défaut. #}
{% block checkbox_row %}
    <div class="field">
        <label class="label"{% if id %} for="{{ id }}"{% endif %}>
            {{ form_widget(form) }}
            {{ block('form_label_content') }}
        </label>
        {{ form_errors(form) }}
    </div>
{% endblock %}
