{% extends 'base.html.twig' %}

{% block title %}{{ 'dojo.list'|trans }} · {{ app_name }}{% endblock %}

{% block body %}
<div class="level">
    <div class="level-left"><h1 class="title">{{ 'dojo.list'|trans }}</h1></div>
    <div class="level-right">
        <a class="button is-primary" href="{{ path('app_dojo_new') }}">{{ 'action.add'|trans }}</a>
    </div>
</div>

<table class="table is-fullwidth is-striped is-hoverable">
    <thead>
    <tr>
        <th>{{ 'dojo.shortname'|trans }}</th>
        <th>{{ 'dojo.name'|trans }}</th>
        <th>{{ 'dojo.city'|trans }}</th>
        <th>{{ 'dojo.country_code'|trans }}</th>
        <th class="has-text-right">{{ 'action.actions'|trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% for dojo in pagination %}
        <tr>
            <td><a href="{{ path('app_dojo_edit', {id: dojo.id}) }}">{{ dojo.shortname }}</a></td>
            <td>{{ dojo.name }}</td>
            <td>{{ dojo.city }}</td>
            <td>{{ dojo.countryCode ? dojo.countryCode|country_name : '' }}</td>
            <td class="has-text-right">
                <div class="field is-grouped is-grouped-right">
                    <p class="control">
                        <a class="button is-small is-light" href="{{ path('app_dojo_edit', {id: dojo.id}) }}">
                            {{ 'action.edit'|trans }}
                        </a>
                    </p>
                    <p class="control">
                        <form method="post" action="{{ path('app_dojo_delete', {id: dojo.id}) }}"
                              onsubmit="return confirm('{{ 'dojo.delete.confirm'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dojo.id) }}">
                            <button class="button is-small is-danger is-light" type="submit">
                                {{ 'action.delete'|trans }}
                            </button>
                        </form>
                    </p>
                </div>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="5" class="has-text-centered has-text-grey">{{ 'dojo.empty'|trans }}</td></tr>
    {% endfor %}
    </tbody>
</table>

<div class="is-flex is-justify-content-center">{{ knp_pagination_render(pagination) }}</div>
{% endblock %}
