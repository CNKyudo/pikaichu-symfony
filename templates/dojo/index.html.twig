{% extends 'base.html.twig' %}

{% block title %}{{ 'dojo.list'|trans }} · {{ app_name }}{% endblock %}

{% block body %}
<h1 class="title">{{ 'dojo.list'|trans }}</h1>

<table class="table">
    <thead>
    <tr class="has-text-centered">
        <th>{{ 'dojo.shortname'|trans }}</th>
        <th>{{ 'dojo.name'|trans }}</th>
        <th>{{ 'dojo.city'|trans }}</th>
        <th>{{ 'dojo.country_code'|trans }}</th>
        <th>
            <a class="button is-small has-background-light" href="{{ path('app_dojo_new') }}" title="{{ 'dojo.new'|trans }}">
                <span class="icon is-small"><i class="fas fa-plus"></i></span>
                <span>{{ 'action.add'|trans }}</span>
            </a>
        </th>
    </tr>
    </thead>
    <tbody>
    {% for dojo in pagination %}
        <tr>
            <td><a href="{{ path('app_dojo_edit', {id: dojo.id}) }}">{{ dojo.shortname }}</a></td>
            <td>{{ dojo.name }}</td>
            <td>{{ dojo.city }}</td>
            <td>{{ dojo.countryCode ? dojo.countryCode|country_name : '' }}</td>
            <td>
                <a class="button is-small has-background-light" href="{{ path('app_dojo_edit', {id: dojo.id}) }}" title="{{ 'dojo.edit'|trans }}">
                    <span class="icon is-small"><i class="fas fa-pen"></i></span>
                </a>
                <form method="post" action="{{ path('app_dojo_delete', {id: dojo.id}) }}" style="display:inline"
                      onsubmit="return confirm('{{ 'dojo.delete.confirm'|trans|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ dojo.id) }}">
                    <button class="button is-small has-background-light" type="submit" title="{{ 'dojo.destroy'|trans }}">
                        <span class="icon is-small"><i class="fas fa-trash"></i></span>
                    </button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="5" class="has-text-centered has-text-grey">{{ 'dojo.empty'|trans }}</td></tr>
    {% endfor %}
    </tbody>
</table>

<div class="is-flex is-justify-content-center">{{ knp_pagination_render(pagination) }}</div>
{% endblock %}
