{% extends 'base.html.twig' %}

{% block title %}{{ 'marking.title'|trans }} · {{ taikai.shortname }}{% endblock %}

{% block body %}
<h1 class="title">{{ 'marking.title'|trans }} — {{ taikai.shortname }}</h1>

<p class="mb-3">
    <a class="button is-light mr-5" href="{{ path('app_taikai_show', {id: taikai.id}) }}">{{ 'marking.back_to_taikai'|trans }}</a>
    <a class="button is-light {{ round is null ? 'is-primary' : '' }}"
       href="{{ path('app_marking_show', {taikaiId: taikai.id}) }}">{{ 'marking.all_rounds'|trans }}</a>
    {% for r in rounds %}
        <a class="button is-light {{ round == r ? 'is-primary' : '' }}"
           href="{{ path('app_marking_show', {taikaiId: taikai.id, round: r}) }}">{{ r }}</a>
    {% endfor %}
</p>

{% set visibleRounds = round is null ? rounds : [round] %}
{% set individual = taikai.form and taikai.form.value == 'individual' %}

<table class="table is-narrow is-striped is-bordered">
    <thead>
    <tr class="has-text-centered">
        <th>{{ 'marking.club'|trans }}</th>
        {% if individual %}
            <th>{{ 'marking.order'|trans }}</th>
        {% else %}
            <th>{{ 'marking.team'|trans }}</th>
        {% endif %}
        <th>{{ 'marking.name'|trans }}</th>
        <th>{{ 'marking.input'|trans }}</th>
        {% for r in visibleRounds %}
            <th colspan="2">{{ 'marking.round'|trans }} {{ r }}</th>
        {% endfor %}
        <th colspan="{{ individual ? 1 : 2 }}">{{ 'marking.score'|trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% if individual %}
        {% for participatingDojo in taikai.participatingDojos %}
            {% for participant in participatingDojo.participants %}
                <tr class="has-text-centered">
                    {% if loop.first %}
                        <th class="is-vcentered" rowspan="{{ participatingDojo.participants|length }}">{{ participatingDojo.displayName }}</th>
                    {% endif %}
                    {{ include('marking/_cells.html.twig', {participant: participant, taikai: taikai, visibleRounds: visibleRounds}) }}
                </tr>
            {% endfor %}
        {% else %}
            <tr><td colspan="{{ individual ? 4 : 5 }}" class="has-text-centered has-text-grey">{{ 'marking.no_participant'|trans }}</td></tr>
        {% endfor %}
    {% else %}
        {% for participatingDojo in taikai.participatingDojos %}
            {% for team in participatingDojo.teams %}
                {% for participant in team.participants %}
                    <tr class="has-text-left">
                        {% if loop.parent.loop.first and loop.first %}
                            <th class="is-vcentered has-text-centered" rowspan="{{ participatingDojo.participants|length }}">{{ participatingDojo.displayName }}</th>
                        {% endif %}
                        {% if loop.first %}
                            <th class="is-vcentered has-text-centered" rowspan="{{ team.participants|length }}">{{ team.index }} - {{ team.shortname }}</th>
                        {% endif %}
                        {{ include('marking/_cells.html.twig', {participant: participant, taikai: taikai, visibleRounds: visibleRounds}) }}
                        {% if loop.first %}
                            <th class="is-vcentered has-text-centered">{{ team.getScore(null) ? team.getScore(null).intermediateHits : 0 }}</th>
                        {% endif %}
                    </tr>
                {% endfor %}
            {% endfor %}
        {% else %}
            <tr><td colspan="{{ individual ? 4 : 5 }}" class="has-text-centered has-text-grey">{{ 'marking.no_participant'|trans }}</td></tr>
        {% endfor %}
    {% endif %}
    </tbody>
</table>
{% endblock %}
