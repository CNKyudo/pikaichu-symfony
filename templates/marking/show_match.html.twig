{% extends 'base.html.twig' %}

{% block title %}{{ 'marking.title'|trans }} · {{ match }}{% endblock %}

{% block body %}
<h1 class="title">{{ 'marking.title'|trans }} — {{ taikai.shortname }}</h1>

<p class="mb-3">
    <a class="button is-light" href="{{ path('app_match_index', {taikaiId: taikai.id}) }}">{{ 'marking.back_to_match'|trans }}</a>
</p>

<table class="table is-narrow is-striped is-bordered">
    <thead>
    <tr class="has-text-centered">
        <th>{{ 'marking.team'|trans }}</th>
        <th>{{ 'marking.name'|trans }}</th>
        <th>{{ 'marking.input'|trans }}</th>
        {% for r in rounds %}
            <th colspan="2">{{ 'marking.round'|trans }} {{ r }}</th>
        {% endfor %}
        <th colspan="2">{{ 'marking.score'|trans }}</th>
    </tr>
    </thead>
    <tbody>
    {% for team in [match.team1, match.team2] %}
        {% if team %}
            {% for participant in team.participants %}
                <tr class="has-text-left">
                    {% if loop.first %}
                        <th class="is-vcentered has-text-centered" rowspan="{{ team.participants|length }}">{{ team.shortname }}</th>
                    {% endif %}
                    {{ include('marking/_cells.html.twig', {participant: participant, taikai: taikai, visibleRounds: rounds, match: match}) }}
                    {% if loop.first %}
                        <th class="is-vcentered has-text-centered" rowspan="{{ team.participants|length }}">
                            {{ team.getScore(match) ? team.getScore(match).intermediateHits : 0 }}
                        </th>
                    {% endif %}
                </tr>
            {% else %}
                <tr><td colspan="6" class="has-text-centered has-text-grey">{{ 'marking.no_participant'|trans }}</td></tr>
            {% endfor %}
        {% endif %}
    {% endfor %}
    </tbody>
</table>
{% endblock %}
