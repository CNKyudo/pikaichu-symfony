{# Vue destinée à la projection en salle : mise en page dédiée, sans menu ni
   frise d'avancement, reprise de `layouts/public.html.erb`. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="refresh" content="5">
    <title>{{ app_name }} - {{ taikai.shortname }}</title>
    {{ include('_head_assets.html.twig') }}
</head>
<body>
<section class="section">
    <div class="container">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="notification is-{{ type == 'error' ? 'danger' : type }}">
                    {{ message is iterable ? message.key|trans(message.parameters|default({})) : message|trans }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <h1 class="title has-text-centered">{{ 'leaderboard.title'|trans }} — {{ taikai.shortname }}</h1>

    {% if taikai.form and taikai.form.value == '2in1' %}
        {% if app.request.query.has('individual') %}
            <p class="mb-6">
                <a class="button is-primary" href="{{ path('app_leaderboard_public', {taikaiId: taikai.id}) }}">
                    {{ 'leaderboard.show_team'|trans }}
                </a>
            </p>
            {{ include('leaderboard/_individual_table.html.twig', {groups: individual}) }}
        {% else %}
            <p class="mb-6">
                <a class="button is-primary" href="{{ path('app_leaderboard_public', {taikaiId: taikai.id, individual: 1}) }}">
                    {{ 'leaderboard.show_individual'|trans }}
                </a>
            </p>
            {{ include('leaderboard/_team_table.html.twig', {groups: teams}) }}
        {% endif %}
    {% elseif taikai.form and taikai.form.value == 'individual' %}
        {{ include('leaderboard/_individual_table.html.twig', {groups: individual}) }}
    {% elseif taikai.form and taikai.form.value == 'matches' %}
        <table class="table is-fullwidth is-striped is-narrow">
            <tbody>
            {% for entry in podium %}
                <tr>
                    <td class="has-text-weight-bold">{{ loop.index }}</td>
                    <td>{{ entry.team.shortname }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% else %}
        {{ include('leaderboard/_team_table.html.twig', {groups: teams}) }}
    {% endif %}
</section>
</body>
</html>
