{% if taikai.form and (taikai.form.value == 'individual' or taikai.form.value == '2in1') %}
    {# Pour un 2-en-1, on affiche équipes et individuel ensemble : plus riche
       que les deux écrans séparés de Rails (`show` + `show_2in1`). #}
    {% if teams|length %}
        <h2 class="title is-4">{{ 'leaderboard.by_team'|trans }}</h2>
        {{ include('leaderboard/_team_table.html.twig', {groups: teams}) }}
        <h2 class="title is-4 mt-5">{{ 'leaderboard.individual'|trans }}</h2>
    {% elseif taikai.distributed %}
        <h2 class="title is-4">{{ 'leaderboard.all'|trans }}</h2>
    {% endif %}
    {{ include('leaderboard/_individual_table.html.twig', {groups: individual}) }}

    {% if taikai.distributed %}
        {% for participatingDojo in taikai.participatingDojos %}
            {% set groups = by_dojo[participatingDojo.id]|default([]) %}
            <h2 class="title is-4 mt-5">{{ participatingDojo.displayName }}</h2>
            {% if groups|length == 0 %}
                <p>{{ 'leaderboard.no_participants_yet'|trans }}</p>
            {% else %}
                {{ include('leaderboard/_individual_table.html.twig', {groups: groups}) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% elseif taikai.form and taikai.form.value == 'team' %}
    {% if taikai.distributed %}
        {% for participatingDojo in taikai.participatingDojos %}
            {% set groups = by_dojo[participatingDojo.id]|default([]) %}
            <h2 class="title is-4 mt-5">{{ participatingDojo.displayName }}</h2>
            {% if groups|length == 0 %}
                <p>{{ 'leaderboard.no_participants_yet'|trans }}</p>
            {% else %}
                {{ include('leaderboard/_team_table.html.twig', {groups: groups}) }}
            {% endif %}
        {% endfor %}
    {% endif %}
{% elseif taikai.form and taikai.form.value == 'matches' %}
    <table class="table is-fullwidth is-striped is-narrow">
        <tbody>
        {% for entry in podium %}
            <tr>
                <td class="has-text-weight-bold">{{ loop.index }}</td>
                <td>{{ entry.team.shortname }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
