{# Tableau de classement générique, réutilisé pour les individuels et les équipes. #}
<table class="table is-fullwidth is-striped is-narrow">
    <thead>
    <tr>
        <th style="width: 5rem">{{ 'leaderboard.rank'|trans }}</th>
        <th>{{ 'leaderboard.name'|trans }}</th>
        <th class="has-text-right" style="width: 6rem">{{ 'leaderboard.hits'|trans }}</th>
        {% if taikai.scoring.usesArrowValues %}
            <th class="has-text-right" style="width: 6rem">{{ 'leaderboard.points'|trans }}</th>
        {% endif %}
    </tr>
    </thead>
    <tbody>
    {% for group in groups %}
        {% for member in group.members %}
            <tr>
                {% if loop.first %}
                    <td rowspan="{{ group.members|length }}" class="has-text-weight-bold">{{ group.rank }}</td>
                {% endif %}
                <td>{{ member.displayName }}</td>
                <td class="has-text-right">{{ group.score ? group.score.hits : (member.getScore() ? member.getScore().hits : 0) }}</td>
                {% if taikai.scoring.usesArrowValues %}
                    <td class="has-text-right">{{ group.score ? group.score.value : (member.getScore() ? member.getScore().value : 0) }}</td>
                {% endif %}
            </tr>
        {% endfor %}
    {% else %}
        <tr><td colspan="4" class="has-text-grey">{{ 'leaderboard.empty'|trans }}</td></tr>
    {% endfor %}
    </tbody>
</table>
