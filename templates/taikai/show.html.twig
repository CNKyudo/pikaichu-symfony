{% extends 'taikai/_layout.html.twig' %}

{% block title %}{{ taikai.shortname }} · {{ app_name }}{% endblock %}

{% block taikai_content %}
<div class="media">
    <div class="media-content has-text-centered">
        <p class="title is-4">{{ 'taikai.overview'|trans }} « {{ taikai.name }} »</p>
        {% if taikai.description %}<p>{{ taikai.description|nl2br }}</p>{% endif %}
    </div>

    <div class="media-right">
        {{ include('taikai/_icons.html.twig', {taikai: taikai, size: ''}) }}
        {% if is_granted('TAIKAI_EDIT', taikai) and taikai.form and taikai.form.value == '2in1' and taikai.currentState.value == 'done' %}
            <form method="post" action="{{ path('app_taikai_generate', {id: taikai.id}) }}"
                  onsubmit="return confirm('{{ 'taikai.generate.confirm'|trans|e('js') }}')">
                <input type="hidden" name="_token" value="{{ csrf_token('generate' ~ taikai.id) }}">
                <div class="field has-addons mt-3">
                    <div class="control">
                        <div class="select">
                            <select name="bracket_size">
                                <option value="4">4</option>
                                <option value="8">8</option>
                            </select>
                        </div>
                    </div>
                    <div class="control">
                        <button class="button" type="submit">{{ 'taikai.generate.action'|trans }}</button>
                    </div>
                </div>
            </form>
        {% endif %}
    </div>
</div>

<div class="content">
    <div class="columns">
        <div class="column">
            <div class="card">
                <header class="card-header"><p class="card-header-title">{{ 'taikai.participants'|trans }}</p></header>
                <div class="card-content">
                    {{ include('taikai/_participants_overview.html.twig') }}
                </div>
            </div>
        </div>

        <div class="column">
            <div class="card mb-5">
                <header class="card-header"><p class="card-header-title">{{ 'taikai.host_clubs'|trans }}</p></header>
                <div class="card-content">
                    {{ include('participating_dojo/_list.html.twig') }}
                </div>
            </div>

            <div class="card">
                <header class="card-header"><p class="card-header-title">{{ 'taikai.staff'|trans }}</p></header>
                <div class="card-content">
                    <table class="table is-narrow">
                        <thead>
                        <tr class="has-text-centered">
                            <th>{{ 'staff.role'|trans }}</th>
                            <th>{{ 'staff.participating_dojo'|trans }}</th>
                            <th>{{ 'staff.display_name'|trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {# Triés par rôle comme le scope `ordered` côté Rails. #}
                        {% for staff in taikai.staffs|sort((a, b) => (a.role ? a.role.translatedLabel(app.request.locale) : '') <=> (b.role ? b.role.translatedLabel(app.request.locale) : '')) %}
                            <tr>
                                <td>{{ staff.role ? staff.role.translatedLabel(app.request.locale) : '' }}</td>
                                <td>{{ staff.participatingDojo ? staff.participatingDojo.displayName : '' }}</td>
                                <td>{{ staff.displayName }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="has-text-grey">{{ 'taikai.no_staff'|trans }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{{ include('taikai/_timeline.html.twig') }}
{% endblock %}
