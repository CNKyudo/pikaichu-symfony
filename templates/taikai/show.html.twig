{% extends 'base.html.twig' %}

{% block title %}{{ taikai.shortname }} · {{ app_name }}{% endblock %}

{% block body %}
<h1 class="title">{{ 'taikai.overview'|trans }} « {{ taikai.shortname }} »</h1>

{{ include('taikai/_state_bar.html.twig') }}

<div class="buttons">
    {% if is_granted('TAIKAI_MARK', taikai) %}
        <a class="button is-link" href="{{ path('app_marking_show', {taikaiId: taikai.id}) }}">
            {{ 'taikai.marking_sheet'|trans }}
        </a>
    {% endif %}
    <a class="button" href="{{ path('app_leaderboard_show', {taikaiId: taikai.id}) }}">
        {{ 'taikai.results'|trans }}
    </a>
    {% if is_granted('TAIKAI_EDIT', taikai) %}
        <a class="button" href="{{ path('app_taikai_edit', {id: taikai.id}) }}">{{ 'action.edit'|trans }}</a>
    {% endif %}
</div>

<div class="columns">
    <div class="column">
        <div class="card">
            <header class="card-header"><p class="card-header-title">{{ 'taikai.details'|trans }}</p></header>
            <div class="card-content content">
                <p><strong>{{ 'taikai.name'|trans }}:</strong> {{ taikai.name }}</p>
                <p><strong>{{ 'taikai.form'|trans }}:</strong> {{ taikai.form ? taikai.form.label|trans : '' }}</p>
                <p><strong>{{ 'taikai.scoring'|trans }}:</strong> {{ taikai.scoring.label|trans }}</p>
                <p><strong>{{ 'taikai.total_num_arrows'|trans }}:</strong> {{ taikai.totalNumArrows }}
                    ({{ taikai.numRounds }} × {{ taikai.numArrows }})</p>
                <p><strong>{{ 'taikai.num_targets'|trans }}:</strong> {{ taikai.numTargets }}</p>
                <p><strong>{{ 'taikai.tachi_size'|trans }}:</strong> {{ taikai.tachiSize }}</p>
                {% if taikai.description %}<p>{{ taikai.description|nl2br }}</p>{% endif %}
            </div>
        </div>
    </div>

    <div class="column">
        <div class="card">
            <header class="card-header"><p class="card-header-title">{{ 'taikai.host_clubs'|trans }}</p></header>
            <div class="card-content">
                <table class="table is-fullwidth is-narrow">
                    <thead>
                    <tr>
                        <th>{{ 'dojo.shortname'|trans }}</th>
                        <th class="has-text-right">{{ 'taikai.participants'|trans }}</th>
                        <th class="has-text-right">{{ 'draw.label'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for participatingDojo in taikai.participatingDojos %}
                        <tr>
                            <td>{{ participatingDojo.displayName }}</td>
                            <td class="has-text-right">{{ participatingDojo.participants|length }}</td>
                            <td class="has-text-right">
                                <span class="tag is-{{ participatingDojo.isDrawn ? 'success' : 'warning' }}">
                                    {{ (participatingDojo.isDrawn ? 'draw.done' : 'draw.pending')|trans }}
                                </span>
                                {# Le tirage au sort n'est possible qu'à l'étape « Enregistrement ». #}
                                {% if taikai.currentState.value == 'registration' and is_granted('TAIKAI_EDIT', taikai) %}
                                    <form method="post" style="display:inline"
                                          action="{{ path('app_participating_dojo_draw', {taikaiId: taikai.id, id: participatingDojo.id}) }}"
                                          onsubmit="return confirm('{{ 'draw.confirm'|trans|e('js') }}')">
                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('draw' ~ participatingDojo.id) }}">
                                        <button class="button is-small ml-2" type="submit">{{ 'draw.label'|trans }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="has-text-grey">{{ 'taikai.no_host_club'|trans }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card mt-4">
            <header class="card-header"><p class="card-header-title">{{ 'taikai.staff'|trans }}</p></header>
            <div class="card-content">
                <table class="table is-fullwidth is-narrow">
                    <tbody>
                    {% for staff in taikai.staffs %}
                        <tr>
                            <td>{{ staff.displayName }}</td>
                            <td>{{ staff.role ? staff.role.translatedLabel(app.request.locale) : '' }}</td>
                            <td>{{ staff.participatingDojo ? staff.participatingDojo.displayName : '' }}</td>
                        </tr>
                    {% else %}
                        <tr><td class="has-text-grey">{{ 'taikai.no_staff'|trans }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% if taikai.events|length %}
    <div class="card mt-4">
        <header class="card-header"><p class="card-header-title">{{ 'taikai.history'|trans }}</p></header>
        <div class="card-content content">
            <ul>
                {% for event in taikai.events %}
                    <li>
                        <small class="has-text-grey">{{ event.createdAt ? event.createdAt|date('d/m/Y H:i') : '' }}</small>
                        — {{ event.message }}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endif %}
{% endblock %}
