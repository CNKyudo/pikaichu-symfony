{# Historique du taikai sous forme de frise, reprise de `taikais/_timeline.html.erb`. #}
<div class="card">
    <header class="card-header"><p class="card-header-title">{{ 'taikai.history'|trans }}</p></header>
    <div class="card-content">
        <div class="timeline is-centered">
            <header class="timeline-header">
                <span class="tag is-medium is-primary">{{ 'taikai.state.new'|trans }}</span>
            </header>
            {% for event in taikai.events %}
                <div class="timeline-item">
                    <div class="timeline-content">
                        <p class="heading">{{ event.createdAt ? event.createdAt|date('d/m/Y H:i') : '' }}</p>
                        <p>{{ event.message }}</p>
                    </div>
                </div>
                {% if event.category == 'state_transition' %}
                    <header class="timeline-header">
                        <span class="tag is-medium is-primary">{{ ('taikai.state.' ~ event.data.to)|trans }}</span>
                    </header>
                {% endif %}
            {% endfor %}
            {% set lastEvent = taikai.events|last %}
            {% if not (lastEvent and lastEvent.category == 'state_transition' and lastEvent.data.to == 'done') %}
                <div class="timeline-item">
                    <div class="timeline-marker is-danger is-icon">
                        <i class="fas fa-location-dot"></i>
                    </div>
                    <div class="timeline-content">
                        <p class="heading">{{ 'taikai.timeline.now'|trans }}</p>
                        <p>{{ 'taikai.timeline.you_are_here'|trans }}</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
