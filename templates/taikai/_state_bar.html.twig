{# Frise d'avancement du taikai, avec les boutons d'étape précédente / suivante. #}
{% set current = taikai.currentState %}

<div class="level">
    <div class="level-left">
        {% if taikai.previousState and taikai.previousState in allowed_transitions %}
            <form method="post" action="{{ path('app_taikai_transition', {id: taikai.id}) }}"
                  onsubmit="return confirm('{{ 'taikai.transition.confirm_backward'|trans|e('js') }}')">
                <input type="hidden" name="_token" value="{{ csrf_token('transition' ~ taikai.id) }}">
                <input type="hidden" name="to_state" value="{{ taikai.previousState.value }}">
                <button class="button is-light" type="submit">&laquo; {{ 'taikai.transition.previous'|trans }}</button>
            </form>
        {% endif %}
    </div>

    <div class="level-item">
        <nav class="breadcrumb has-succeeds-separator" aria-label="{{ 'taikai.state'|trans }}">
            <ul>
                {% for state in states %}
                    <li class="{{ state == current ? 'is-active' : '' }}">
                        <a>{{ state.position }} {{ state.label|trans }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    </div>

    <div class="level-right">
        {% if taikai.nextState and taikai.nextState in allowed_transitions %}
            <form method="post" action="{{ path('app_taikai_transition', {id: taikai.id}) }}"
                  onsubmit="return confirm('{{ 'taikai.transition.confirm_forward'|trans|e('js') }}')">
                <input type="hidden" name="_token" value="{{ csrf_token('transition' ~ taikai.id) }}">
                <input type="hidden" name="to_state" value="{{ taikai.nextState.value }}">
                <button class="button is-primary" type="submit">{{ 'taikai.transition.next'|trans }} &raquo;</button>
            </form>
        {% endif %}
    </div>
</div>
