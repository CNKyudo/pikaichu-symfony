KERNEL_CLASS='App\Kernel'
APP_SECRET='test_secret_not_used_in_production'
APP_ENV=test
# Le seuil du bridge Symfony est laissé permissif à dessein : depuis PHPUnit 10,
# c'est PHPUnit qui arbitre les dépréciations et conditionne le code de sortie.
# Le garde-fou réel est `failOnDeprecation` dans phpunit.xml.dist ; deux seuils
# concurrents ici ne feraient que dédoubler les rapports.
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
